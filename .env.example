# Postgres connection string. Vercel fills this in automatically when you connect a Neon database.
DATABASE_URL=postgres://user:password@host/db?sslmode=require
# The email address that becomes the site admin when it signs up.
ADMIN_EMAIL=
# A long random password shared with the helper program on your PC (worker/config.json).
WORKER_SECRET=
# "local" (default): the AI runs on your PC. "claude": the site uses the Claude API instead.
LLM_MODE=local
# Only needed when LLM_MODE=claude. Get one at https://console.anthropic.com
ANTHROPIC_API_KEY=
# Only needed when LLM_MODE=claude. Any long random string; Vercel uses it for the daily poem job.
CRON_SECRET=
# Time zone that decides when a new day (and a new poem) starts.
SITE_TIMEZONE=America/New_York
